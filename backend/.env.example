# Copy to .env (never commit it). The API key stays on this server; the APK never contains it.
ANTHROPIC_API_KEY=
# Shared secret the app sends as "Authorization: Bearer <token>" (set the same value in the app's Settings)
APP_CLIENT_TOKEN=change-me
PORT=8080

# Multi-agent committee (comma-separated lists run one agent per model)
MODEL_BLUEPRINT=claude-opus-5-5
MODEL_SETTERS=claude-opus-5-5,claude-sonnet-5-5
MODEL_REVIEWER=claude-opus-5-5
MODEL_SOLVERS=claude-opus-5-5,claude-sonnet-5-5,claude-opus-5-5
MODEL_ADJUDICATOR=claude-opus-5-5
MODEL_MODERATOR=claude-opus-5-5
# Votes needed (solvers + adjudicator) for a disputed answer to be accepted
CONSENSUS_QUORUM=2

# Effort per role: low | medium | high | xhigh | max
EFFORT_SETTER=high
EFFORT_SOLVER=high
EFFORT_ADJUDICATOR=max

BATCH_SIZE=5
MAX_CONCURRENCY=4
MAX_REGEN_ROUNDS=2
RATE_LIMIT_PER_HOUR=20
