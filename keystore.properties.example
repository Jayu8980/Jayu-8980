# AutoTube AI - release signing configuration (template)
#
# How to use:
#   1. Copy this file to "keystore.properties" in the SAME folder (the project root, next to
#      settings.gradle.kts):   cp keystore.properties.example keystore.properties
#   2. Fill in the four values below for YOUR keystore (.jks).
#   3. Build:  ./gradlew assembleRelease   (Windows: gradlew.bat assembleRelease)
#      Output: app/build/outputs/apk/release/app-release.apk
#
# Never commit keystore.properties or your .jks file to Git. *.jks and *.keystore are already
# ignored by .gitignore; make sure keystore.properties is listed there too before you commit.
# Back up the .jks file and its passwords somewhere safe (password manager + cloud drive).
# If you lose them you can never ship an update over an installed copy, and the SHA-1
# registered in Google Cloud for YouTube sign-in no longer matches anything you can build.
#
# Values in this file win over the CI environment variables SIGNING_STORE_FILE,
# SIGNING_STORE_PASSWORD, SIGNING_KEY_ALIAS and SIGNING_KEY_PASSWORD (see app/build.gradle.kts).
# If storeFile is missing or points to a file that does not exist, the release build quietly
# falls back to the DEBUG key. Check which key was used with:  ./gradlew signingReport

# Path to the keystore file. A relative path is resolved from the app/ module folder (not the
# project root), so a keystore stored in the project root is "../autotube.jks".
# Absolute paths work too. On Windows use forward slashes (C:/Users/me/keys/autotube.jks),
# because a backslash is an escape character in .properties files.
storeFile=../autotube.jks

# Password of the keystore file (the one keytool or Android Studio asked you to create).
storePassword=CHANGE_ME_store_password

# Alias of the key inside the keystore, e.g. the value you passed to keytool -alias.
keyAlias=autotube

# Password of the key itself. Keystores made by modern keytool (PKCS12, the default since JDK 9)
# use the store password for the key as well, so this is usually the same as storePassword.
keyPassword=CHANGE_ME_key_password
