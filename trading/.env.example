# Copy to .env (never commit it). All secrets come from the environment.
AITRADER_KITE_API_KEY=
AITRADER_KITE_API_SECRET=
AITRADER_KITE_ACCESS_TOKEN=        # issued daily by Kite's login flow
AITRADER_ANTHROPIC_API_KEY=
AITRADER_RISK_SIGNING_KEY=          # HMAC key for approval tokens; >= 32 random bytes, hex
AITRADER_REDIS_URL=redis://localhost:6379/0
AITRADER_POSTGRES_DSN=postgresql://aitrader@localhost/aitrader
AITRADER_TELEGRAM_BOT_TOKEN=
AITRADER_TELEGRAM_CHAT_ID=
